# App
NODE_ENV="development"

# Your database connection.
# Local example: postgresql://postgres:postgres@localhost:5432/myapp
DATABASE_URL=""

# App URL — change this when deploying.
NEXTAUTH_URL="http://localhost:3000"

# Just put any random secret here.
# For a real project, use something long and random.
AUTH_SECRET="secret"


# GitHub login
# Create an OAuth App here:
# https://github.com/settings/developers
#
# Callback URL for local development:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""


# Google login
# Create OAuth credentials here:
# https://console.cloud.google.com/apis/credentials
#
# Callback URL:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# Emails
# Get your API key here:
# https://resend.com/api-keys
RESEND_API_KEY=""

# Fine for local development.
# In production, use an email from your verified domain.
EMAIL_FROM="onboarding@resend.dev"


# Image uploads
# Create a Cloudinary account:
# https://cloudinary.com/
#
# You can find all three values in:
# Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# 2FA
# Generate a random key, for example:
# openssl rand -hex 32
#
# Keep this secret — it's used to encrypt 2FA data.
TWO_FACTOR_ENCRYPTION_KEY=""
